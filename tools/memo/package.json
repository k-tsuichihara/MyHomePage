{
  "name": "myhomepage-memo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:preview": "node scripts/build-preview.mjs",
    "build:product": "node scripts/build-product.mjs",
    "preview": "npm run build:preview && node scripts/serve-preview.mjs",
    "test:e2e": "playwright test",
    "build:persistence": "node scripts/build-persistence.mjs",
    "test:persistence": "npm run build:persistence && node .persistence/run.mjs",
    "build:format": "node scripts/build-format.mjs",
    "test:format": "npm run build:format && node .format/run.mjs",
    "build:transition": "node scripts/build-transition.mjs",
    "test:transition": "npm run build:transition && node .transition/run.mjs",
    "build:cloud-offline": "node scripts/build-cloud-offline.mjs",
    "build:auth": "node scripts/build-auth.mjs",
    "test:auth-patch": "node --test tests/auth-browser/sdk-patch.test.mjs",
    "build:auth-browser": "node scripts/build-auth-browser.mjs",
    "build:readonly-trial-browser": "node scripts/build-readonly-trial-browser.mjs",
    "test:readonly-trial-browser": "npm run build:readonly-trial-browser && node --experimental-strip-types tests/readonly-trial-browser/run.ts",
    "human-gate:offline": "npm run test:readonly-trial-browser",
    "build:human-gate": "node scripts/build-human-gate-runner.mjs",
    "human-gate": "npm run build:readonly-trial-browser && npm run build:human-gate && node .human-gate/run.mjs",
    "test:auth-browser": "npm run build:auth-browser && node .auth-browser/run.mjs",
    "test:cloud-offline": "npm run build:cloud-offline && node .cloud-live/offline.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
